# Configuration inventory. Codex must align names/formats with the implemented libraries.
# UI preview works without .env. Runtime DB access requires DATABASE_URL; auth secrets await implementation.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://parcel_dev:parcel_dev_local@localhost:5432/parcel_delivery

# Server-only auth and tracking secrets. Document key generation/rotation when implemented.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
TRACKING_ENCRYPTION_KEY=
TRACKING_HMAC_KEY=

BUSINESS_TIMEZONE=Asia/Yangon
APP_CURRENCY=MMK
MONEY_DECIMAL_PLACES=2

# Local MinIO defaults only; replace credentials before production.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=parcel-proof-private
S3_ACCESS_KEY_ID=parcel_local
S3_SECRET_ACCESS_KEY=parcel_local_secret_change_me
S3_FORCE_PATH_STYLE=true
PHOTO_MAX_BYTES=10485760

# No live sending until a provider is approved/configured and explicitly enabled.
SMS_ENABLED=false
SMS_ADAPTER=local
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=

# Production must use shared rate limiting. Local backend is development only.
RATE_LIMIT_BACKEND=local
RATE_LIMIT_STORE_URL=
