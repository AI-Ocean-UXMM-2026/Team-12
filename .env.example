# Configuration inventory. Codex must align names/formats with the implemented libraries.
# UI preview works without .env. Runtime DB access requires DATABASE_URL; auth secrets await implementation.
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://parcel_dev:parcel_dev_local@localhost:5432/parcel_delivery

# Server-only auth and tracking secrets. Document key generation/rotation when implemented.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
TRACKING_ENCRYPTION_KEY=
TRACKING_HMAC_KEY=

BUSINESS_TIMEZONE=Asia/Yangon
APP_CURRENCY=MMK
MONEY_DECIMAL_PLACES=2

# Local MinIO defaults only; replace credentials before production.
STORAGE_ADAPTER=s3
# Vercel production: STORAGE_ADAPTER=vercel-blob, connect a PRIVATE Blob store.
BLOB_READ_WRITE_TOKEN=
# Vercel Marketplace provides these; Prisma migrations prefer the unpooled URL.
DATABASE_URL_UNPOOLED=
# Vercel Cron authentication; independent random value, at least 32 characters.
CRON_SECRET=
# Local fallback: STORAGE_ADAPTER=filesystem, private durable files outside public.
PRIVATE_STORAGE_PATH=.local/private-objects
# Explicit opt-in for loopback-only production-build testing with local adapters.
LOCAL_PRODUCTION_TEST=false
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=parcel-proof-private
S3_ACCESS_KEY_ID=parcel_local
S3_SECRET_ACCESS_KEY=parcel_local_secret_change_me
S3_FORCE_PATH_STYLE=true
PHOTO_MAX_BYTES=10485760

# SMS is not required for tracking. These flags are for legacy local outbox tooling only.
SMS_ENABLED=false
SMS_ADAPTER=local
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=

# Production must use shared rate limiting. Local backend is development only.
RATE_LIMIT_BACKEND=local
TRUST_PROXY=false
RATE_LIMIT_STORE_URL=

# Local seed only. env:local generates a random value. Never use a development seed in production.
SEED_PASSWORD=
