generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RIDER
}

enum VehicleType {
  DELIVERY_VAN
  CAR
  BICYCLE
}

enum PaymentType {
  PREPAID
  COD
}

enum ReceivingOption {
  HOME
  NEIGHBOUR
  DOOR
}

enum CustomerStatus {
  PROCESSING_DELIVERY
  ON_THE_WAY
  DELIVERED
  DELAY
}

enum DeliveryResult {
  CUSTOMER_UNREACHABLE
  DELIVERED_HOME
  DELIVERED_TO_NEIGHBOUR
  LEFT_AT_DOOR
}

enum AssignmentLifecycle {
  ACTIVE
  REASSIGNED
  COMPLETED
}

enum PhotoLifecycle {
  STAGED
  ATTACHED
  DELETE_PENDING
}

enum OutboxState {
  PENDING
  PROCESSING
  SENT
  FAILED
}

// Identity foundation only. Extend/reconcile this model with the chosen auth
// library before connecting operational routes. No credentials are seeded.
model User {
  id             String       @id @default(uuid()) @db.Uuid
  email          String       @unique @db.VarChar(254)
  name           String       @db.VarChar(120)
  role           Role
  active         Boolean      @default(true)
  sessionVersion Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  rider          Rider?
  createdParcels Parcel[]     @relation("ParcelCreator")
  assignments    Assignment[] @relation("AssignmentCreator")
  uploads        PhotoAsset[]
}

model Rider {
  id            String              @id @default(uuid()) @db.Uuid
  // Nullable while staging profiles; assignment services must require active login.
  userId        String?             @unique @db.Uuid
  user          User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  name          String              @db.VarChar(120)
  contactNumber String              @db.VarChar(32)
  vehicleType   VehicleType
  vehicleNumber String?             @db.VarChar(80)
  active        Boolean             @default(true)
  version       Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  assignments   Assignment[]
  notifications RiderNotification[]
  attempts      DeliveryAttempt[]

  @@index([active, name])
  @@index([contactNumber])
}

model Parcel {
  id                     String              @id @default(uuid()) @db.Uuid
  parcelCode             String              @unique @db.VarChar(64)
  trackingCodeHash       String              @unique @db.VarChar(128)
  trackingCodeCiphertext String
  trackingCodeNonce      String
  trackingKeyVersion     Int                 @default(1)
  senderName             String              @db.VarChar(120)
  receivedDate           DateTime            @db.Date
  receivedPerson         String              @db.VarChar(120)
  createdByAdminId       String              @db.Uuid
  createdByAdmin         User                @relation("ParcelCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  customerName           String              @db.VarChar(120)
  customerContactNumber  String              @db.VarChar(32)
  township               String              @db.VarChar(120)
  address                String              @db.VarChar(1000)
  deliveryNote           String?             @db.VarChar(2000)
  paymentType            PaymentType
  orderAmount            Decimal?            @db.Decimal(18, 2)
  deliveryFee            Decimal             @db.Decimal(18, 2)
  currency               String              @default("MMK") @db.VarChar(3)
  receivingOption        ReceivingOption     @default(HOME)
  deliveryInstruction    String?             @db.VarChar(2000)
  customerStatus         CustomerStatus      @default(PROCESSING_DELIVERY)
  currentAssignmentId    String?             @unique @db.Uuid
  currentAssignment      Assignment?         @relation("CurrentAssignment", fields: [currentAssignmentId, id], references: [id, parcelId], onDelete: NoAction, onUpdate: NoAction)
  deliveredAt            DateTime?
  version                Int                 @default(0)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  assignments            Assignment[]        @relation("ParcelAssignments")
  attempts               DeliveryAttempt[]
  photos                 PhotoAsset[]
  notifications          RiderNotification[]
  auditEvents            AuditEvent[]

  @@unique([currentAssignmentId, id])
}

model Assignment {
  id                   String              @id @default(uuid()) @db.Uuid
  parcelId             String              @db.Uuid
  parcel               Parcel              @relation("ParcelAssignments", fields: [parcelId], references: [id], onDelete: Restrict)
  currentForParcel     Parcel?             @relation("CurrentAssignment")
  riderId              String              @db.Uuid
  rider                Rider               @relation(fields: [riderId], references: [id], onDelete: Restrict)
  assignedByAdminId    String              @db.Uuid
  assignedByAdmin      User                @relation("AssignmentCreator", fields: [assignedByAdminId], references: [id], onDelete: Restrict)
  assignDate           DateTime            @db.Date
  deliveryDate         DateTime            @db.Date
  expectedDeliveryDate DateTime            @db.Date
  lifecycle            AssignmentLifecycle @default(ACTIVE)
  latestResult         DeliveryResult?
  endedAt              DateTime?
  version              Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  attempts             DeliveryAttempt[]
  photos               PhotoAsset[]
  notifications        RiderNotification[]
  auditEvents          AuditEvent[]
  // Partial uniqueness of active parcel assignment is added in migration SQL.

  @@unique([id, parcelId])
  @@index([riderId, deliveryDate, lifecycle])
  @@index([parcelId])
}

model DeliveryAttempt {
  id             String         @id @default(uuid()) @db.Uuid
  assignmentId   String         @db.Uuid
  parcelId       String         @db.Uuid
  assignment     Assignment     @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  parcel         Parcel         @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  riderId        String         @db.Uuid
  rider          Rider          @relation(fields: [riderId], references: [id], onDelete: Restrict)
  result         DeliveryResult
  photoAssetId   String?        @unique @db.Uuid
  photo          PhotoAsset?    @relation(fields: [photoAssetId], references: [id], onDelete: Restrict)
  idempotencyKey String         @db.VarChar(128)
  submittedAt    DateTime       @default(now())

  @@unique([riderId, idempotencyKey])
  @@index([assignmentId, submittedAt])
}

model PhotoAsset {
  id           String           @id @default(uuid()) @db.Uuid
  storageKey   String           @unique
  detectedMime String           @db.VarChar(64)
  byteSize     Int
  checksum     String
  uploaderId   String           @db.Uuid
  uploader     User             @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  parcelId     String           @db.Uuid
  parcel       Parcel           @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  assignmentId String           @db.Uuid
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  lifecycle    PhotoLifecycle   @default(STAGED)
  createdAt    DateTime         @default(now())
  attempt      DeliveryAttempt?

  @@index([lifecycle, createdAt])
}

model RiderNotification {
  id           String      @id @default(uuid()) @db.Uuid
  riderId      String      @db.Uuid
  rider        Rider       @relation(fields: [riderId], references: [id], onDelete: Restrict)
  parcelId     String?     @db.Uuid
  parcel       Parcel?     @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  assignmentId String?     @db.Uuid
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  type         String      @db.VarChar(64)
  deliveryDate DateTime?   @db.Date
  snapshot     Json
  createdAt    DateTime    @default(now())
  readAt       DateTime?

  @@index([riderId, createdAt])
  @@index([riderId, readAt])
  @@index([riderId, deliveryDate])
}

model AuditEvent {
  id           String      @id @default(uuid()) @db.Uuid
  actorType    String      @db.VarChar(32)
  actorId      String?
  parcelId     String?     @db.Uuid
  parcel       Parcel?     @relation(fields: [parcelId], references: [id], onDelete: Restrict)
  assignmentId String?     @db.Uuid
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  eventType    String      @db.VarChar(80)
  metadata     Json
  requestId    String?
  createdAt    DateTime    @default(now())

  @@index([parcelId, createdAt])
}

model OutboxEvent {
  id               String      @id @default(uuid()) @db.Uuid
  eventType        String      @db.VarChar(64)
  entityId         String
  protectedPayload String
  deduplicationKey String      @unique
  state            OutboxState @default(PENDING)
  attemptCount     Int         @default(0)
  nextAttemptAt    DateTime    @default(now())
  lockedAt         DateTime?
  lastError        String?
  sentAt           DateTime?
  createdAt        DateTime    @default(now())

  @@index([state, nextAttemptAt])
}

model IdempotencyRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  actorId            String
  action             String   @db.VarChar(80)
  key                String   @db.VarChar(128)
  requestFingerprint String
  response           Json
  createdAt          DateTime @default(now())
  expiresAt          DateTime

  @@unique([actorId, action, key])
  @@index([expiresAt])
}
