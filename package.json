{
  "name": "parcel-delivery-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "postinstall": "prisma generate",
    "test:smoke": "node scripts/smoke.mjs",
    "env:local": "node scripts/local-env.mjs",
    "storage:init": "tsx scripts/storage-init.ts",
    "worker:once": "tsx workers/outbox.ts",
    "photos:cleanup": "node --conditions=react-server --import tsx scripts/cleanup-photos.ts",
    "test:integration": "tsx tests/integration/journeys.ts",
    "test:outbox": "tsx tests/integration/outbox.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "outbox:retry": "tsx scripts/retry-outbox.ts",
    "test:performance": "tsx scripts/performance.ts",
    "test:maintenance": "node --conditions=react-server --import tsx tests/integration/maintenance.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@hookform/resolvers": "5.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-auth": "^1.7.12",
    "dotenv": "^17.0.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.0.0",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
